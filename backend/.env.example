# Configuration du service de stockage HANI'S

# Port du serveur
PORT=3001

# Environnement (development | production)
NODE_ENV=development

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:5173

# Provider de stockage (local | supabase | cloudinary)
STORAGE_PROVIDER=local

# ============================================
# STOCKAGE LOCAL
# ============================================
LOCAL_UPLOAD_DIR=./uploads
LOCAL_BASE_URL=http://localhost:3001/uploads

# ============================================
# SUPABASE STORAGE
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_BUCKET=hanis-images

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# SÉCURITÉ
# ============================================
# Taille max des fichiers (en bytes)
MAX_FILE_SIZE=5242880

# Types MIME autorisés
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# Dimensions max (pixels)
MAX_WIDTH=4096
MAX_HEIGHT=4096

# Qualité d'optimisation (1-100)
IMAGE_QUALITY=85

# ============================================
# AUTHENTIFICATION (optionnel)
# ============================================
# Clé API pour les admins (pour upload produit/galerie)
ADMIN_API_KEY=your-secret-admin-api-key

# JWT Secret (si vous utilisez JWT)
JWT_SECRET=your-jwt-secret
