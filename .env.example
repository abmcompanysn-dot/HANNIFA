# Configuration ABMCY Core pour HANI'S
# Copier ce fichier vers .env et remplir avec vos valeurs

# URL de l'API ABMCY (ne pas modifier sauf si nécessaire)
VITE_ABMCY_API_URL=https://api.abmcy.com

# Clé API tenant (fournie par ABMCY à la création du compte)
# Trouvable dans votre dashboard ABMCY
VITE_ABMCY_API_KEY=pk_live_votre_cle_ici

# Slug du tenant (identifiant unique de votre compte)
VITE_ABMCY_TENANT_SLUG=hanis
